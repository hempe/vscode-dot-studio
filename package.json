        "command": "shinobi.solutionExplorer.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "shinobi.solutionExplorer.focusedNodeType =~ /^(folder|file)$/"
      },
      {
        "command": "shinobi.solutionExplorer.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "shinobi.solutionExplorer.focusedNodeType =~ /^(folder|file)$/"
      },
      {
        "command": "shinobi.solutionExplorer.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "shinobi.solutionExplorer.focusedNodeType =~ /^(project|folder|file)$/"
      },
      {
        "command": "shinobi.solutionExplorer.rename",
        "key": "f2",
        "when": "shinobi.solutionExplorer.focusedNodeType =~ /^(solution|solutionFolder|project|folder|file|solutionItem)$/"
      },
      {
        "command": "shinobi.solutionExplorer.deleteFile",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "shinobi.solutionExplorer.focusedNodeType =~ /^(folder|file)$/"
      },
      {
        "command": "shinobi.solutionExplorer.removeSolutionFolder",
        "key": "delete",
