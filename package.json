      {
        "command": "shinobi.solutionExplorer.addAssemblyReference",
        "title": "Add Assembly Reference...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.manageNuGetPackages",
        "title": "Manage NuGet Packages...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.manageUserSecrets",
        "title": "Manage User Secrets",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.manageNuGetPackagesForSolution",
        "title": "Manage NuGet Packages...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.restoreNugets",
        "title": "Restore NuGet Packages",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.restoreDependencies",
        "title": "Restore Dependencies",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.setStartupProject",
        "title": "Set as Startup Project",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.chooseLaunchProfile",
        "title": "Set Launch Profile...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addServiceReference",
        "title": "Add Service Reference...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.updateServiceReference",
        "title": "Update Service Reference",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.removeServiceReference",
        "title": "Remove Service Reference",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.startNewInstance",
        "title": "Start New Instance",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.startWithoutDebugging",
        "title": "Start Without Debugging",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.runTests",
        "title": "Run Tests",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.debugTests",
        "title": "Debug Tests",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.build",
        "title": "Build",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.rebuild",
        "title": "Rebuild",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.clean",
        "title": "Clean",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.copy",
        "title": "Copy",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.cut",
        "title": "Cut",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.paste",
        "title": "Paste",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.rename",
        "title": "Rename",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.deleteFile",
        "title": "Delete",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.deleteProject",
        "title": "Delete",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.removeProject",
        "title": "Remove from Solution",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.removeSolutionFolder",
        "title": "Remove",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.removeSolutionItem",
        "title": "Remove from Solution",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.removeDependency",
        "title": "Remove",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.openInTerminal",
        "title": "Open in Terminal",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.copyFullPath",
        "title": "Copy Full Path",
        "category": ".NET"
      }
