    "submenus": [
      {
        "id": "shinobi.solution.configurations",
        "label": "Solution Configuration",
        "icon": "$(settings-gear)"
      },
      {
        "id": "shinobi.solutionExplorer.debug",
        "label": "Debug"
      }
    ],
    "menus": {
      "view/title": [
        {
          "submenu": "shinobi.solution.configurations",
          "when": "view == shinobi-solution-webview || view == shinobi-solution-webview-secondary-sidebar",
          "group": "navigation@0"
        },
        {
          "command": "shinobi.solution.selectFramework",
          "when": "view == shinobi-solution-webview || view == shinobi-solution-webview-secondary-sidebar",
          "group": "navigation@1"
        },
        {
          "command": "shinobi.solution.debug",
          "when": "view == shinobi-solution-webview || view == shinobi-solution-webview-secondary-sidebar",
          "group": "navigation@2"
        },
        {
          "command": "shinobi.solution.startWithoutDebugging",
          "when": "view == shinobi-solution-webview || view == shinobi-solution-webview-secondary-sidebar",
          "group": "navigation@3"
        },
        {
          "command": "shinobi.solution.syncWithActiveDocument",
          "when": "view == shinobi-solution-webview || view == shinobi-solution-webview-secondary-sidebar",
          "group": "navigation@4"
        },
        {
          "command": "shinobi.solution.collapseAll",
          "when": "view == shinobi-solution-webview || view == shinobi-solution-webview-secondary-sidebar",
          "group": "navigation@5"
        }
      ],
      "shinobi.solution.configurations": [
        {
          "command": "shinobi.solution.configuration.debug",
          "when": "'Debug' in shinobi.solution.availableConfigurations && shinobi.solution.configuration != 'Debug'",
          "group": "1_configurations@1"
        },
        {
          "command": "shinobi.solution.configuration.debug.active",
          "when": "shinobi.solution.configuration == 'Debug'",
          "group": "1_configurations@1"
        },
        {
          "command": "shinobi.solution.configuration.release",
          "when": "'Release' in shinobi.solution.availableConfigurations && shinobi.solution.configuration != 'Release'",
          "group": "1_configurations@2"
        },
        {
          "command": "shinobi.solution.configuration.release.active",
          "when": "shinobi.solution.configuration == 'Release'",
          "group": "1_configurations@2"
        },
        {
          "command": "shinobi.solution.selectConfiguration",
          "when": "shinobi.solution.hasOtherConfigurations",
          "group": "2_other@1"
        }
      ],
      "webview/context": [
        {
          "command": "shinobi.solutionExplorer.addNewProject",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addExistingProject",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "1_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.addSolutionFolder",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "1_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.addSolutionItem",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "1_group@4"
        },
        {
          "command": "shinobi.solutionExplorer.manageNuGetPackagesForSolution",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "2_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.build",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "3_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.rebuild",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "3_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.clean",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "3_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.restoreNugets",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "3_group@4"
        },
        {
          "command": "shinobi.solutionExplorer.runTests",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "4_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.debugTests",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "4_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.rename",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "5_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.copyFullPath",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "6_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.revealInExplorer",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "6_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.openInTerminal",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "6_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.addNewProject",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionFolder'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addExistingProject",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionFolder'",
          "group": "1_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.addSolutionFolder",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionFolder'",
          "group": "1_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.addSolutionItem",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionFolder'",
          "group": "1_group@4"
        },
        {
          "command": "shinobi.solutionExplorer.removeSolutionFolder",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionFolder'",
          "group": "2_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.rename",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionFolder'",
          "group": "2_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.revealInExplorer",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionFolder'",
          "group": "3_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.editProjectFile",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addNewItem",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "2_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addExistingItem",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "2_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.addFile",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "2_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.addFolder",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "2_group@4"
        },
        {
          "command": "shinobi.solutionExplorer.addServiceReference",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "2_group@5"
        },
        {
          "command": "shinobi.solutionExplorer.paste",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "3_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.manageNuGetPackages",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "5_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.manageUserSecrets",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "5_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.rename",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "6_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.removeProject",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "6_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.deleteProject",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "6_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.build",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "7_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.rebuild",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "7_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.clean",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "7_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.copyFullPath",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "9_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.revealInExplorer",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "9_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.openInTerminal",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
