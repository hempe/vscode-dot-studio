        "when": "shinobi.solutionExplorer.focusedNodeType =~ /^(solutionFolder)$/"
      },
      {
        "command": "shinobi.solutionExplorer.removeSolutionItem",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "shinobi.solutionExplorer.focusedNodeType =~ /^(solutionItem)$/"
      },
      {
        "command": "shinobi.solutionExplorer.removeDependency",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "shinobi.solutionExplorer.focusedNodeType =~ /^(dependency)$/"
      }
