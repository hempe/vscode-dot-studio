{
  "name": "dotnet",
  "displayName": "Shinobi .NET",
  "description": "Enhanced .NET development features including NuGet UI, solution support, and project management",
  "version": "0.0.1",
  "publisher": "shinobi",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hempe/vscode-dot-studio"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:*.sln",
    "workspaceContains:*.slnx"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Shinobi .NET",
      "properties": {
        "shinobi.solutionExplorer.location": {
          "type": "string",
          "enum": [
            "sidebar",
            "secondary-sidebar"
          ],
          "enumDescriptions": [
            "Show Solution Explorer in the left sidebar (Sidebar)",
            "Show Solution Explorer in the right sidebar (Secondary Sidebar)"
          ],
          "default": "sidebar",
          "description": "Choose where the Solution Explorer appears"
        },
        "shinobi.diagnostics.showErrors": {
          "type": "boolean",
          "default": true,
          "description": "Show errors in the Error List and mark them in the Solution Explorer (the Error List's Errors toggle)"
        },
        "shinobi.diagnostics.showWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings in the Error List and mark them in the Solution Explorer (the Error List's Warnings toggle)"
        },
        "shinobi.diagnostics.showInfos": {
          "type": "boolean",
          "default": false,
          "description": "Show infos and suggestions (the ··· hints in the editor, Visual Studio's \"Messages\") in the Error List and mark them in the Solution Explorer (the Error List's Messages toggle)"
        },
        "shinobi.solutionExplorer.diagnostics.showInfos": {
          "type": "boolean",
          "default": false,
          "description": "Also mark infos and suggestions (the ··· hints in the editor, Visual Studio's \"Messages\") in the Solution Explorer; errors and warnings are always marked",
          "deprecationMessage": "Use shinobi.diagnostics.showInfos, which the Error List toggles share with the Solution Explorer.",
          "markdownDeprecationMessage": "Use `#shinobi.diagnostics.showInfos#`, which the Error List toggles share with the Solution Explorer."
        }
      }
    },
    "configurationDefaults": {
      "dotnet.server.useOmnisharp": false,
      "dotnet.codeLens.enableTestsCodeLens": false
    },
    "taskDefinitions": [
      {
        "type": "shinobi-dotnet",
        "required": [
          "action",
          "target"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "build",
              "rebuild",
              "clean",
              "restore"
            ],
            "description": "The dotnet action to run"
          },
          "target": {
            "type": "string",
            "description": "Absolute path of the solution or project file"
          },
          "configuration": {
            "type": "string",
            "description": "Build configuration (Debug, Release, ...); the active solution configuration when not set"
          }
        }
      }
    ],
    "views": {
      "shinobi-solution-explorer": [
        {
          "id": "shinobi-solution-webview",
          "name": "Solution Explorer",
          "icon": "$(folder-library)",
          "type": "webview",
          "when": "shinobi.workspaceHasDotnetFiles && config.shinobi.solutionExplorer.location != 'secondary-sidebar'"
        }
      ],
      "shinobi-solution-explorer-secondary-sidebar": [
        {
          "id": "shinobi-solution-webview-secondary-sidebar",
          "name": "Solution Explorer",
          "icon": "$(folder-library)",
          "type": "webview",
          "when": "shinobi.workspaceHasDotnetFiles && config.shinobi.solutionExplorer.location == 'secondary-sidebar'"
        }
      ],
      "shinobi-error-list": [
        {
          "id": "shinobi.errorList",
          "name": "Error List",
          "when": "shinobi.workspaceHasDotnetFiles",
          "type": "webview",
          "icon": "$(checklist)"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shinobi-solution-explorer",
          "title": "Solution",
          "icon": "$(folder-library)"
        }
      ],
      "secondarySidebar": [
        {
          "id": "shinobi-solution-explorer-secondary-sidebar",
          "title": "Solution",
          "icon": "$(folder-library)"
        }
      ],
      "panel": [
        {
          "id": "shinobi-error-list",
          "title": "Error List",
          "icon": "$(checklist)"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "shinobi.nugetPackageManager",
        "displayName": "NuGet Package Manager",
        "selector": [
          {
            "filenamePattern": "*.nuget"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "shinobi.openNuGetManager",
        "title": "Open NuGet Package Manager",
        "category": ".NET"
      },
      {
        "command": "shinobi.openNuGetManagerForSolution",
        "title": "Open NuGet Package Manager for Solution",
        "category": ".NET"
      },
      {
        "command": "shinobi.solution.selectFramework",
        "title": "Select Framework",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "shinobi.solution.configuration.debug",
        "title": "Debug"
      },
      {
        "command": "shinobi.solution.configuration.debug.active",
        "title": "✓ Debug"
      },
      {
        "command": "shinobi.solution.configuration.release",
        "title": "Release"
      },
      {
        "command": "shinobi.solution.configuration.release.active",
        "title": "✓ Release"
      },
      {
        "command": "shinobi.solution.selectConfiguration",
        "title": "Select Solution Configuration...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solution.debug",
        "title": "Start Debugging",
        "icon": "$(debug-start)"
      },
      {
        "command": "shinobi.solution.startWithoutDebugging",
        "title": "Start Without Debugging",
        "category": ".NET",
        "icon": "$(run)"
      },
      {
        "command": "shinobi.solution.syncWithActiveDocument",
        "title": "Sync with Active Document",
        "category": ".NET",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "shinobi.solution.collapseAll",
        "title": "Collapse All",
        "category": ".NET",
        "icon": "$(collapse-all)"
      },
      {
        "command": "shinobi.solutionExplorer.openFile",
        "title": "Open",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.editProjectFile",
        "title": "Edit Project File",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addNewProject",
        "title": "Add New Project...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addExistingProject",
        "title": "Add Existing Project...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addSolutionFolder",
        "title": "Add Solution Folder",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addSolutionItem",
        "title": "Add Solution Item...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addFile",
        "title": "Add File...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addNewItem",
        "title": "Add New Item...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addExistingItem",
        "title": "Add Existing Item...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addFolder",
