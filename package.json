{
  "name": "dotnet",
  "displayName": "Shinobi .NET",
  "description": "Enhanced .NET development features including NuGet UI, solution support, and project management",
  "version": "0.0.1",
  "publisher": "shinobi",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hempe/vscode-dot-studio"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:*.sln",
    "workspaceContains:*.slnx"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Shinobi .NET",
      "properties": {
        "shinobi.solutionExplorer.location": {
          "type": "string",
          "enum": [
            "sidebar",
            "secondary-sidebar"
          ],
          "enumDescriptions": [
            "Show Solution Explorer in the left sidebar (Sidebar)",
            "Show Solution Explorer in the right sidebar (Secondary Sidebar)"
          ],
          "default": "sidebar",
          "description": "Choose where the Solution Explorer appears"
        },
        "shinobi.solutionExplorer.diagnostics.showInfos": {
          "type": "boolean",
          "default": false,
          "description": "Also mark infos and suggestions (the ··· hints in the editor, Visual Studio's \"Messages\") in the Solution Explorer; errors and warnings are always marked"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "shinobi-dotnet",
        "required": [
          "action",
          "target"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "build",
              "rebuild",
              "clean",
              "restore"
            ],
            "description": "The dotnet action to run"
          },
          "target": {
            "type": "string",
            "description": "Absolute path of the solution or project file"
          }
        }
      }
    ],
    "views": {
      "shinobi-solution-explorer": [
        {
          "id": "shinobi-solution-webview",
          "name": "Solution Explorer",
          "icon": "$(folder-library)",
          "type": "webview",
          "when": "shinobi.workspaceHasDotnetFiles && config.shinobi.solutionExplorer.location != 'secondary-sidebar'"
        }
      ],
      "shinobi-solution-explorer-secondary-sidebar": [
        {
          "id": "shinobi-solution-webview-secondary-sidebar",
          "name": "Solution Explorer",
          "icon": "$(folder-library)",
          "type": "webview",
          "when": "shinobi.workspaceHasDotnetFiles && config.shinobi.solutionExplorer.location == 'secondary-sidebar'"
        }
      ],
      "shinobi-error-list": [
        {
          "id": "shinobi.errorList",
          "name": "Error List",
          "when": "shinobi.workspaceHasDotnetFiles"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shinobi-solution-explorer",
          "title": "Solution",
          "icon": "$(folder-library)"
        }
      ],
      "secondarySidebar": [
        {
          "id": "shinobi-solution-explorer-secondary-sidebar",
          "title": "Solution",
          "icon": "$(folder-library)"
        }
      ],
      "panel": [
        {
          "id": "shinobi-error-list",
          "title": "Error List",
          "icon": "$(checklist)"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "shinobi.nugetPackageManager",
        "displayName": "NuGet Package Manager",
        "selector": [
          {
            "filenamePattern": "*.nuget"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "shinobi.openNuGetManager",
        "title": "Open NuGet Package Manager",
        "category": ".NET"
      },
      {
        "command": "shinobi.openNuGetManagerForSolution",
        "title": "Open NuGet Package Manager for Solution",
        "category": ".NET"
      },
      {
        "command": "shinobi.solution.selectFramework",
        "title": "Select Framework",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "shinobi.solution.debug",
        "title": "Start Debugging",
        "icon": "$(debug-start)"
      },
      {
        "command": "shinobi.errorList.hideErrors",
        "title": "Hide Errors",
        "category": "Error List",
        "icon": "$(error)"
      },
      {
        "command": "shinobi.errorList.showErrors",
        "title": "Show Errors",
        "category": "Error List",
        "icon": "$(circle-slash)"
      },
      {
        "command": "shinobi.errorList.hideWarnings",
        "title": "Hide Warnings",
        "category": "Error List",
        "icon": "$(warning)"
      },
      {
        "command": "shinobi.errorList.showWarnings",
        "title": "Show Warnings",
        "category": "Error List",
        "icon": "$(circle-slash)"
      },
      {
        "command": "shinobi.errorList.hideMessages",
        "title": "Hide Messages",
        "category": "Error List",
        "icon": "$(info)"
      },
      {
        "command": "shinobi.errorList.showMessages",
        "title": "Show Messages",
        "category": "Error List",
        "icon": "$(circle-slash)"
      },
      {
        "command": "shinobi.solutionExplorer.openFile",
        "title": "Open",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addNewProject",
        "title": "Add New Project...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addExistingProject",
        "title": "Add Existing Project...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addSolutionFolder",
        "title": "Add Solution Folder",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addSolutionItem",
        "title": "Add Solution Item...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addFile",
        "title": "Add File...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addFolder",
        "title": "Add Folder...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addProjectReference",
        "title": "Add Project Reference...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.addAssemblyReference",
        "title": "Add Assembly Reference...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.manageNuGetPackages",
        "title": "Manage NuGet Packages...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.manageNuGetPackagesForSolution",
        "title": "Manage NuGet Packages...",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.restoreNugets",
        "title": "Restore NuGet Packages",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.restoreDependencies",
        "title": "Restore Dependencies",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.setStartupProject",
        "title": "Set as Startup Project",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.build",
        "title": "Build",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.rebuild",
        "title": "Rebuild",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.clean",
        "title": "Clean",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.copy",
        "title": "Copy",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.cut",
        "title": "Cut",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.paste",
        "title": "Paste",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.rename",
        "title": "Rename",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.deleteFile",
        "title": "Delete",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.deleteProject",
        "title": "Delete",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.removeProject",
        "title": "Remove from Solution",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.removeSolutionFolder",
        "title": "Remove",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.removeSolutionItem",
        "title": "Remove from Solution",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.removeDependency",
        "title": "Remove",
        "category": ".NET"
      },
      {
        "command": "shinobi.solutionExplorer.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": ".NET"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "shinobi.solution.selectFramework",
          "when": "view == shinobi-solution-webview || view == shinobi-solution-webview-secondary-sidebar",
          "group": "navigation@1"
        },
        {
          "command": "shinobi.solution.debug",
          "when": "view == shinobi-solution-webview || view == shinobi-solution-webview-secondary-sidebar",
          "group": "navigation@2"
        },
        {
          "command": "shinobi.errorList.hideErrors",
          "when": "view == shinobi.errorList && shinobi.errorList.errorsShown",
          "group": "navigation@1"
        },
        {
          "command": "shinobi.errorList.showErrors",
          "when": "view == shinobi.errorList && !shinobi.errorList.errorsShown",
          "group": "navigation@1"
        },
        {
          "command": "shinobi.errorList.hideWarnings",
          "when": "view == shinobi.errorList && shinobi.errorList.warningsShown",
          "group": "navigation@2"
        },
        {
          "command": "shinobi.errorList.showWarnings",
          "when": "view == shinobi.errorList && !shinobi.errorList.warningsShown",
          "group": "navigation@2"
        },
        {
          "command": "shinobi.errorList.hideMessages",
          "when": "view == shinobi.errorList && shinobi.errorList.messagesShown",
          "group": "navigation@3"
        },
        {
          "command": "shinobi.errorList.showMessages",
          "when": "view == shinobi.errorList && !shinobi.errorList.messagesShown",
          "group": "navigation@3"
        }
      ],
      "webview/context": [
        {
          "command": "shinobi.solutionExplorer.addNewProject",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addExistingProject",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "1_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.addSolutionFolder",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "1_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.addSolutionItem",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "1_group@4"
        },
        {
          "command": "shinobi.solutionExplorer.manageNuGetPackagesForSolution",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "2_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.build",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "3_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.rebuild",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "3_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.clean",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "3_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.restoreNugets",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "3_group@4"
        },
        {
          "command": "shinobi.solutionExplorer.rename",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "4_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.revealInExplorer",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solution'",
          "group": "5_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addSolutionFolder",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionFolder'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addSolutionItem",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionFolder'",
          "group": "1_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.removeSolutionFolder",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionFolder'",
          "group": "2_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.rename",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionFolder'",
          "group": "2_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.revealInExplorer",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionFolder'",
          "group": "3_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.openFile",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addFile",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "2_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addFolder",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "2_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.paste",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "3_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.setStartupProject",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "4_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.manageNuGetPackages",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "5_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.rename",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "6_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.removeProject",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "6_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.deleteProject",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "6_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.build",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "7_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.rebuild",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "7_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.clean",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "7_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.revealInExplorer",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'project'",
          "group": "8_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addFile",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'folder'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addFolder",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'folder'",
          "group": "1_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.copy",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'folder'",
          "group": "2_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.cut",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'folder'",
          "group": "2_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.paste",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'folder'",
          "group": "2_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.rename",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'folder'",
          "group": "3_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.deleteFile",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'folder'",
          "group": "3_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.revealInExplorer",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'folder'",
          "group": "4_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.openFile",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'file'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.copy",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'file'",
          "group": "2_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.cut",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'file'",
          "group": "2_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.paste",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'file'",
          "group": "2_group@3"
        },
        {
          "command": "shinobi.solutionExplorer.rename",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'file'",
          "group": "3_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.deleteFile",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'file'",
          "group": "3_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.revealInExplorer",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'file'",
          "group": "4_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.manageNuGetPackages",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'dependencies'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addProjectReference",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'dependencies'",
          "group": "2_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addAssemblyReference",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'dependencies'",
          "group": "2_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.restoreDependencies",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'dependencies'",
          "group": "3_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.removeDependency",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'dependency'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.manageNuGetPackages",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'dependencyCategory' && contextValue == 'packages'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.restoreDependencies",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'dependencyCategory' && contextValue == 'packages'",
          "group": "2_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addProjectReference",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'dependencyCategory' && contextValue == 'projects'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.addAssemblyReference",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'dependencyCategory' && contextValue == 'assemblies'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.openFile",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionItem'",
          "group": "1_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.rename",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionItem'",
          "group": "2_group@1"
        },
        {
          "command": "shinobi.solutionExplorer.removeSolutionItem",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionItem'",
          "group": "2_group@2"
        },
        {
          "command": "shinobi.solutionExplorer.revealInExplorer",
          "when": "webviewId =~ /^shinobi-solution-webview/ && webviewSection == 'node' && nodeType == 'solutionItem'",
          "group": "3_group@1"
        }
      ],
      "commandPalette": [
        {
          "command": "shinobi.solutionExplorer.openFile",
          "when": "false"
