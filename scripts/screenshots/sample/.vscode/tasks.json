{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "StartupPreBuild",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "src/Shop.Web/Shop.Web.csproj",
                "--framework",
                "net10.0",
                "--configuration",
                "Debug",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "-property:EmitCompilerGeneratedFiles=true"
            ],
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
