<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Microsoft.CodeAnalysis.ExternalAccess.Extensions (the server's message handler interfaces) is only on this feed -->
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Microsoft.CodeAnalysis.*: the releases from nuget.org, the previews (the build for Roslyn 5.13) from dotnet-tools -->
    <packageSource key="nuget.org"><package pattern="*" /><package pattern="Microsoft.CodeAnalysis.*" /></packageSource>
    <packageSource key="dotnet-tools"><package pattern="Microsoft.CodeAnalysis.ExternalAccess.Extensions" /><package pattern="Microsoft.CodeAnalysis.*" /></packageSource>
  </packageSourceMapping>
</configuration>
